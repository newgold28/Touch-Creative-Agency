# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form leads are emailed (your existing domain inbox)
CONTACT_EMAIL=info@touchcreativeagency.com

# Sender address for contact emails. Use a verified sender on your domain,
# e.g. "Touch Creative Agency <hello@touchcreative.agency>". While your
# domain is unverified, leave the default onboarding@resend.dev.
CONTACT_FROM_EMAIL=Touch Creative Agency <onboarding@resend.dev>

# Newsletter: create an Audience in Resend and paste its ID to store
# subscribers there. Leave empty to just get an admin notification email.
RESEND_AUDIENCE_ID=

# Sender address for newsletter emails (same rules as CONTACT_FROM_EMAIL)
NEWSLETTER_FROM_EMAIL=Touch Creative Agency <onboarding@resend.dev>
